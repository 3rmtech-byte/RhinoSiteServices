frontend/screens/jobs.js
import { getAll } from "../core/database.js";

export async function renderJobs() {
  const jobs = await getAll("jobs");

  document.getElementById("app").innerHTML = `
    <h2>Trabajos</h2>
    <ul>
      ${jobs.map((j) => `<li>${j.cliente} — ${j.estado}</li>`).join("")}
    </ul>
  `;
}
