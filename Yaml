version: "3.9"

services:
  db:
    image: postgres:15
    container_name: app_db
    restart: always
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: fieldapp
    ports:
      - "5432:5432"
    volumes:
      - db_data:/var/lib/postgresql/data

  backend:
    build: ./backend
    container_name: app_backend
    depends_on:
      - db
    environment:
      - DATABASE_URL=postgres://postgres:postgres@db:5432/fieldapp
      - PORT=3000
    ports:
      - "3000:3000"
    volumes:
      - ./backend:/usr/src/app

  frontend:
    build: ./frontend
    container_name: app_frontend
    depends_on:
      - backend
    ports:
      - "8080:80"

volumes:
  db_data:
